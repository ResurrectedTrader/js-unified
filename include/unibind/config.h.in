#pragma once
// Generated by CMake from include/unibind/config.h.in - do not edit the generated copy.
//
// Everything in here changes the layout or the semantics of a public type, so
// it has to be identical in every translation unit of a build tree. That is
// why it is generated once rather than passed as a per-target -D.
//
// **Nothing in here names a backend**, and that is the point of it. A consumer
// compiles against these headers once and picks `unibind_backend_v8` or
// `unibind_backend_spidermonkey` at the final link; which engine is underneath
// is a runtime question, answered by `Platform::BackendName()`. A public header
// that branched on the backend would quietly break that, so no public header
// may name one - a rule the build checks rather than leaving to review, in
// tools/headers_only.

// ---------------------------------------------------------------------------
// Handle checking. See docs/lifetimes.md section 9.
//
// 1 makes ub::Local carry a frame epoch, so using a handle after its scope
// closed is diagnosed instead of silently reading a stale slot. It changes
// sizeof(ub::Local<T>) from 8 to 12 on x86 - on x64 the epoch fits in padding
// the handle already had - and it changes what the library does either way,
// which is why it is baked in here for the whole build tree.
// ---------------------------------------------------------------------------
#define UNIBIND_HANDLE_CHECKS @UNIBIND_HANDLE_CHECKS@

// ---------------------------------------------------------------------------
// Inline storage for backend types that must live on the caller's stack.
//
// A HandleScope owns its frame in place, because on SpiderMonkey the frame IS
// a JS::Rooted and JS::Rooted is stack-only. The backend static_asserts that
// its own type fits; growing past these numbers is a compile error in the
// backend, never a silent heap fallback.
//
// **Each number is the maximum across every backend for this architecture**,
// not this backend's own figure. It has to be: the caller compiles these
// sizes into their own stack frames once and links whichever backend they
// like, so a per-backend number would be a different `HandleScope` per engine
// and the single compile would be a lie. A backend whose frame is larger
// raises the number for everyone rather than getting one of its own - the
// cost is stack bytes in a scope that was already there, and the alternative
// is the mismatch this whole header exists to make impossible.
// ---------------------------------------------------------------------------
#define UNIBIND_FRAME_STORAGE_SIZE @UNIBIND_FRAME_STORAGE_SIZE@
#define UNIBIND_FRAME_STORAGE_ALIGN @UNIBIND_FRAME_STORAGE_ALIGN@
#define UNIBIND_TRY_CATCH_STORAGE_SIZE @UNIBIND_TRY_CATCH_STORAGE_SIZE@
#define UNIBIND_TRY_CATCH_STORAGE_ALIGN @UNIBIND_TRY_CATCH_STORAGE_ALIGN@
#define UNIBIND_CONTEXT_SCOPE_STORAGE_SIZE @UNIBIND_CONTEXT_SCOPE_STORAGE_SIZE@
#define UNIBIND_CONTEXT_SCOPE_STORAGE_ALIGN @UNIBIND_CONTEXT_SCOPE_STORAGE_ALIGN@

// Number of handles a frame holds without touching the heap. Matches
// SpiderMonkey's StackGCVector inline capacity so the two agree.
#define UNIBIND_FRAME_INLINE_SLOTS @UNIBIND_FRAME_INLINE_SLOTS@
