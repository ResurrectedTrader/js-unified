+/* vcpkg: the generated header names the built-in modules of a static Windows core that
+   still use single-phase init - extension modules built in (PC/config.c) and the core's own
+   (_datetime, _tracemalloc). Their state is in C globals, which interpreters with their own
+   GIL must not share. _imp.create_dynamic refuses such a .pyd in an interpreter with
+   check_multi_interp_extensions set, but only after running its init function;
+   create_builtin checks only when the module is already in the extensions cache, so the
+   first such interpreter to import one gets it and every later one is refused. Refuse them
+   always, before init runs, so that nothing of theirs is made in the wrong interpreter. */
+#ifdef MS_WINDOWS
+#  include "vcpkg_builtin_modules.h"
+#endif
+#ifndef VCPKG_BUILTIN_SINGLE_PHASE
+#  define VCPKG_BUILTIN_SINGLE_PHASE
+#endif
+
+static int
+vcpkg_is_single_phase_builtin(const char *name)
+{
+    static const char *const names[] = { VCPKG_BUILTIN_SINGLE_PHASE NULL };
+    for (const char *const *n = names; *n != NULL; n++) {
+        if (strcmp(*n, name) == 0) {
+            return 1;
+        }
+    }
+    return 0;
+}
