diff --git a/Python/initconfig.c b/Python/initconfig.c
index ed4c4e2..69e3848 100644
--- a/Python/initconfig.c
+++ b/Python/initconfig.c
@@ -560,6 +560,20 @@ done:
 void
 _Py_ClearStandardStreamEncoding(void)
 {
+    /* Every interpreter calls this, from init_sys_streams(), but only the
+       main interpreter's first initialization can find anything to free:
+       Py_SetStandardStreamEncoding() refuses once Python is initialized.
+       Return before touching the allocators when there is nothing to do.
+       _PyMem_SetDefaultAllocator() replaces the process-wide RAW allocator,
+       which every other thread reads without a lock - a sub-interpreter with
+       its own GIL runs while this one starts - and in a Py_DEBUG build (or
+       with debug hooks installed) the "default" it installs is, for a
+       moment, one without the debug hooks: a block another thread
+       allocates or frees meanwhile goes through the wrong allocator. */
+    if (_Py_StandardStreamEncoding == NULL && _Py_StandardStreamErrors == NULL) {
+        return;
+    }
+
     /* Use the same allocator than Py_SetStandardStreamEncoding() */
     PyMemAllocatorEx old_alloc;
     _PyMem_SetDefaultAllocator(PYMEM_DOMAIN_RAW, &old_alloc);
